USEMODULE_INCLUDES_gnrc_send := $(LAST_MAKEFILEDIR)/include
USEMODULE_INCLUDES += $(USEMODULE_INCLUDES_gnrc_send)
CFLAGS += -DCONFIG_GNRC_IPV6_NIB_SLAAC=1
CFLAGS += -DCONFIG_GNRC_IPV6_NIB_ARSM=1
CFLAGS += -DCONFIG_NDP_RETRANS_TIMER_MS=8000u
CFLAGS += -DAUTO_INIT_PRIO_MOD_MBEDTLS=AUTO_INIT_PRIORITY_AFTER\(AUTO_INIT_PRIO_MOD_RANDOM\)

PSEUDOMODULES += gnrc_send_c509
PSEUDOMODULES += gnrc_send_clear_cp
