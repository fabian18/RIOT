menuconfig KCONFIG_USEMODULE_MBEDTLS_RANDOM
    bool "Configure mbed TLS random data generation"
    help
        Configure mbed TLS random data generation using Kconfig.

if KCONFIG_USEMODULE_MBEDTLS_RANDOM

config MBEDTLS_CTR_DRBG_C
    bool "Enable the CTR_DRBG AES-based random generator"
    default y

endif # KCONFIG_USEMODULE_MBEDTLS_RANDOM
