ifneq (,$(filter mbedtls_x509_crt_write,$(USEMODULE)))
  CFLAGS += -DCONFIG_MBEDTLS_X509_CRT_WRITE_C=1
endif

ifneq (,$(filter mbedtls_x509_csr_write,$(USEMODULE)))
  CFLAGS += -DCONFIG_MBEDTLS_X509_CSR_WRITE_C=1
endif
